{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@mingxu/core": ["../../packages/core/src/index.ts"],
      "@mingxu/prompt": ["../../packages/prompt/src/index.ts"],
      "@mingxu/render": ["../../packages/render/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
