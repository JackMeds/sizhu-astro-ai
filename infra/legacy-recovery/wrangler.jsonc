{
  "name": "mingxu-legacy-recovery",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  // Add the astrocopy.jackmeds.top route only during the reviewed release.
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "NEW_SITE_READY": "false",
    "NEW_ORIGIN": "https://mingxu.jackmeds.top"
  }
}
